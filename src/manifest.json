{
  "manifest_version": 3,
  "name": "Tickets <--> Github Extension",
  "description": "An extension to connect Jira or Linear tickets to GitHub PRs",
  "version": "0.1.0",
  "action": {
    "default_title": "Tickets <-> GitHub"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "<all_urls>"],
      "js": ["js/contentScript.bundle.js"],
      "css": ["contentStyles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "js/eventPage.bundle.js"
  },
  "icons": {
    "16": "assets/logo.png",
    "48": "assets/logo.png",
    "128": "assets/logo.png"
  },
  "permissions": ["tabs", "activeTab", "alarms", "storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "host_permissions": ["https://github.com/*", "<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
